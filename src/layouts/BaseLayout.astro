---
import "../styles.css";
import "../blog.css";

type Props = {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  tags?: string[];
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noIndex?: boolean;
};

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image = "/growthcast-og.png",
  type = "website",
  publishedTime,
  tags = [],
  schema = [],
  noIndex = false,
} = Astro.props;
const canonicalUrl = new URL(canonical, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
const schemas = Array.isArray(schema) ? schema : [schema];
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "GrowthCast",
  url: "https://growthcast.app/",
  logo: "https://growthcast.app/growthcast-logo.webp",
  description: "GTM Engineering for Growth.",
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f1e9" />
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <meta name="author" content="GrowthCast" />
    <link rel="icon" href="/growthcast-logo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/growthcast-logo.webp" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="GrowthCast Blog RSS Feed" href="/rss.xml" />
    <meta property="og:site_name" content="GrowthCast" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
    {schemas.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <slot />
  </body>
</html>
