---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogShell from "../../components/BlogShell.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
const featured = posts.find((post) => post.data.featured);
const title = "Growth Strategy and GTM Engineering Blog | GrowthCast";
const description = "Practical guides to growth modeling, demand, conversion, retention, revenue operations, and GTM engineering.";
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "GrowthCast Blog",
  description,
  url: "https://growthcast.app/blog",
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    url: `https://growthcast.app/blog/${post.id}`,
    datePublished: post.data.publishedAt.toISOString(),
  })),
};
const formatDate = (date: Date) => new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }).format(date);
---
<BaseLayout title={title} description={description} canonical="/blog" schema={blogSchema}>
  <BlogShell current="blog">
    <main class="blogMain">
      <nav class="blogBreadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Blog</span></nav>
      <section class="blogHero">
        <span class="sectionLabel">Ideas for the whole growth system</span>
        <h1>Growth should add up.</h1>
        <p>Clear thinking for teams connecting demand, product, sales, data, and revenue.</p>
      </section>

      <form class="blogFilters" action="/blog" method="get" role="search">
        <label for="blog-search">Search the blog</label>
        <div>
          <input id="blog-search" name="q" type="search" placeholder="Search topics and articles" />
          <input id="blog-tag" type="hidden" name="tag" />
          <button type="submit">Search</button>
        </div>
      </form>

      {tags.length > 0 && (
        <nav class="blogTags" aria-label="Filter by topic">
          <a class="active" data-blog-tag="" href="/blog">All</a>
          {tags.map((tag) => {
            return <a data-blog-tag={tag} href={`/blog?tag=${encodeURIComponent(tag)}`}>{tag}</a>;
          })}
        </nav>
      )}

      {featured && (
        <article class="featuredPost" data-featured-post data-search={`${featured.data.title} ${featured.data.description} ${featured.data.tags.join(" ")}`.toLowerCase()} data-tags={featured.data.tags.join("|")}>
          <div>
            <span class="sectionLabel">Featured</span>
            <h2><a href={`/blog/${featured.id}`}>{featured.data.title}</a></h2>
            <p>{featured.data.description}</p>
          </div>
          <div class="postMeta">
            <time datetime={featured.data.publishedAt.toISOString()}>{formatDate(featured.data.publishedAt)}</time>
            <span>{featured.data.author}</span>
            <a href={`/blog/${featured.id}`}>Read article →</a>
          </div>
        </article>
      )}

      <section class="postSection" aria-labelledby="articles-title" hidden={posts.length === 1 && Boolean(featured)}>
        <div class="postSectionHeading">
          <h2 id="articles-title">Latest articles</h2>
          <span id="blog-result-count">{posts.length} {posts.length === 1 ? "article" : "articles"}</span>
        </div>
        <div class="postGrid">
            {posts.map((post) => (
              <article
                class="postCard"
                hidden={post.id === featured?.id}
                data-post-card
                data-featured={post.id === featured?.id ? "true" : "false"}
                data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(" ")}`.toLowerCase()}
                data-tags={post.data.tags.join("|")}
              >
                <div class="postCardTags">{post.data.tags.slice(0, 2).map((tag) => <span>{tag}</span>)}</div>
                <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
                <p>{post.data.description}</p>
                <footer>
                  <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
                  <a href={`/blog/${post.id}`} aria-label={`Read ${post.data.title}`}>Read →</a>
                </footer>
              </article>
            ))}
          </div>
          <div class="blogEmpty" data-blog-empty hidden><h3>No articles found.</h3><p>Try a broader search or clear the topic filter.</p><a href="/blog">View all articles</a></div>
      </section>

      <aside class="blogCta">
        <span class="sectionLabel">Put the ideas to work</span>
        <h2>Build the model behind your growth plan.</h2>
        <p>Connect traffic, conversion, customers, recurring revenue, and channel spend in one local-first forecast.</p>
        <a href="/resources/tools/forecast">Build a free forecast</a>
      </aside>
    </main>
  </BlogShell>
  <script>
    const params = new URLSearchParams(window.location.search);
    const query = (params.get("q") || "").trim().toLowerCase();
    const tag = (params.get("tag") || "").trim();
    const filtering = Boolean(query || tag);
    const searchInput = document.querySelector<HTMLInputElement>("#blog-search");
    const tagInput = document.querySelector<HTMLInputElement>("#blog-tag");
    if (searchInput) searchInput.value = params.get("q") || "";
    if (tagInput) tagInput.value = tag;
    document.querySelectorAll<HTMLElement>("[data-blog-tag]").forEach((link) => {
      link.classList.toggle("active", (link.dataset.blogTag || "") === tag);
    });
    const featured = document.querySelector<HTMLElement>("[data-featured-post]");
    if (featured) featured.hidden = filtering;
    let matches = 0;
    document.querySelectorAll<HTMLElement>("[data-post-card]").forEach((card) => {
      const queryMatch = !query || (card.dataset.search || "").includes(query);
      const tagMatch = !tag || (card.dataset.tags || "").split("|").includes(tag);
      const show = queryMatch && tagMatch && (filtering || card.dataset.featured !== "true");
      card.hidden = !show;
      if (show) matches += 1;
    });
    const section = document.querySelector<HTMLElement>(".postSection");
    if (section) section.hidden = !filtering && matches === 0;
    const heading = document.querySelector<HTMLElement>("#articles-title");
    if (heading) heading.textContent = filtering ? "Matching articles" : "Latest articles";
    const count = document.querySelector<HTMLElement>("#blog-result-count");
    const total = filtering ? matches : matches + (featured ? 1 : 0);
    if (count) count.textContent = `${total} ${total === 1 ? "article" : "articles"}`;
    const empty = document.querySelector<HTMLElement>("[data-blog-empty]");
    if (empty) empty.hidden = matches > 0;
  </script>
</BaseLayout>
