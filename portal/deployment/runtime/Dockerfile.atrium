FROM oven/bun:1.3.9@sha256:856da45d07aeb62eb38ea3e7f9e1794c0143a4ff63efb00e6c4491b627e2a521 AS build
WORKDIR /upstream
COPY upstream/ ./
COPY atrium-patches/ /patches/
RUN bun /patches/apply.mjs
RUN bun install --frozen-lockfile
RUN bun run --filter @atrium/database db:generate && bun run --filter @atrium/email build
RUN bun test apps/api/src/common/guards/verified-access.spec.ts apps/api/src/workspace-mail.spec.ts apps/api/src/resource-planning.spec.ts apps/api/src/email-brand.spec.ts apps/api/src/payment-methods.spec.ts apps/api/src/revenue-report.spec.ts apps/api/src/file-library.spec.ts
RUN bun run --filter @atrium/api build
# Prisma's exact version and Bun layout are fixed by the upstream lockfile.
RUN cp -R node_modules/.bun/@prisma+client@6.19.2/node_modules/.prisma/client /generated-client

FROM oven/bun:1.3.9@sha256:856da45d07aeb62eb38ea3e7f9e1794c0143a4ff63efb00e6c4491b627e2a521 AS production-dependencies
WORKDIR /upstream
COPY upstream/ ./
RUN bun install --frozen-lockfile --production --ignore-scripts

FROM node:24-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf AS boundary
WORKDIR /boundary
COPY gateway/package*.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

FROM oven/bun:1.3.9@sha256:856da45d07aeb62eb38ea3e7f9e1794c0143a4ff63efb00e6c4491b627e2a521
WORKDIR /upstream
COPY --from=production-dependencies /upstream/node_modules ./node_modules
COPY --from=production-dependencies /upstream/apps/api/node_modules ./apps/api/node_modules
COPY --from=production-dependencies /upstream/packages/database/node_modules ./packages/database/node_modules
COPY --from=production-dependencies /upstream/packages/email/node_modules ./packages/email/node_modules
COPY --from=build /generated-client ./node_modules/.bun/@prisma+client@6.19.2/node_modules/.prisma/client
COPY --from=build /upstream/apps/api/dist ./apps/api/dist
COPY --from=build /upstream/packages/email/dist ./packages/email/dist
COPY upstream/package.json upstream/bun.lock upstream/LICENSE ./
COPY upstream/apps/api/package.json ./apps/api/package.json
COPY upstream/packages/database/package.json ./packages/database/package.json
COPY upstream/packages/database/src ./packages/database/src
COPY upstream/packages/shared/package.json ./packages/shared/package.json
COPY upstream/packages/shared/src ./packages/shared/src
COPY upstream/packages/email/package.json ./packages/email/package.json
COPY --from=boundary /boundary/node_modules /boundary/node_modules
COPY deployment/ /boundary/deployment/
RUN chmod -R a+rX /upstream /boundary
RUN mkdir -p /run/delivered /run/origin /run/connections /run/storage /run/config && chown 1000:1000 /run/delivered /run/origin /run/connections /run/storage /run/config && chmod 700 /run/delivered /run/origin /run/connections /run/storage /run/config
VOLUME ["/run/delivered", "/run/origin", "/run/connections", "/run/storage", "/run/config", "/tmp"]
USER bun
WORKDIR /upstream/apps/api
ENV GC_SERVICE=atrium
ENTRYPOINT ["/usr/local/bin/bun", "/boundary/deployment/runtime/start.mjs"]
CMD ["/usr/local/bin/bun", "/upstream/apps/api/dist/main.js"]
