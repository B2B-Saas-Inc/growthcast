# Server-side values for the separate staging Vercel project.
PORTAL_ENV=staging
WEB_URL=https://clients.staging.growthcast.app
API_ORIGIN=https://api.clients.staging.growthcast.app
GATEWAY_ORIGIN=https://sign.clients.staging.growthcast.app
# Inject API_ORIGIN_SECRET as a Vercel sensitive variable; do not put it here.
# NEXT_PUBLIC_API_URL must be empty so browser requests stay same-origin.
NEXT_PUBLIC_API_URL=
# Backend/database/signing credentials stay in AWS Secrets Manager, not Vercel.
