{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Independent GrowthCast Phase 2 production API",
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.90.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {}
    },
    "Attachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "Routes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "Routes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      },
      "DependsOn": "Attachment"
    },
    "Subnet0": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.90.0.0/24",
        "AvailabilityZone": "us-east-1a",
        "MapPublicIpOnLaunch": false
      }
    },
    "RouteAssociation0": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet0"
        },
        "RouteTableId": {
          "Ref": "Routes"
        }
      }
    },
    "Subnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.90.1.0/24",
        "AvailabilityZone": "us-east-1b",
        "MapPublicIpOnLaunch": false
      }
    },
    "RouteAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "Subnet1"
        },
        "RouteTableId": {
          "Ref": "Routes"
        }
      }
    },
    "ApiSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Staging API: ALB-only ingress; HTTPS and database TLS egress",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 465,
            "ToPort": 465,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "LoadBalancerSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Staging HTTPS listener only",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 3001,
            "ToPort": 3001,
            "DestinationSecurityGroupId": {
              "Ref": "ApiSecurityGroup"
            }
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 3002,
            "ToPort": 3002,
            "DestinationSecurityGroupId": {
              "Ref": "ApiSecurityGroup"
            }
          }
        ]
      }
    },
    "ApiIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "ApiSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 3001,
        "ToPort": 3001,
        "SourceSecurityGroupId": {
          "Ref": "LoadBalancerSecurityGroup"
        }
      }
    },
    "LoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Type": "application",
        "Scheme": "internet-facing",
        "Subnets": [
          {
            "Ref": "Subnet0"
          },
          {
            "Ref": "Subnet1"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "LoadBalancerSecurityGroup"
          }
        ],
        "LoadBalancerAttributes": [
          {
            "Key": "routing.http.drop_invalid_header_fields.enabled",
            "Value": "true"
          },
          {
            "Key": "routing.http.desync_mitigation_mode",
            "Value": "strictest"
          }
        ]
      },
      "DependsOn": "Attachment"
    },
    "Target": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Port": 3001,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "HealthCheckPath": "/api/health",
        "Matcher": {
          "HttpCode": "403"
        },
        "HealthCheckIntervalSeconds": 15,
        "HealthyThresholdCount": 2,
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ]
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "LoadBalancer"
        },
        "Port": 443,
        "Protocol": "HTTPS",
        "SslPolicy": "ELBSecurityPolicy-TLS13-1-2-2021-06",
        "Certificates": [
          {
            "CertificateArn": "arn:aws:acm:us-east-1:059393269249:certificate/538b800d-4529-4ff2-bb87-e23b0c236c25"
          }
        ],
        "DefaultActions": [
          {
            "Type": "fixed-response",
            "FixedResponseConfig": {
              "StatusCode": "404",
              "ContentType": "text/plain",
              "MessageBody": "Unavailable"
            }
          }
        ]
      }
    },
    "ApiRoute": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "Listener"
        },
        "Priority": 10,
        "Conditions": [
          {
            "Field": "host-header",
            "Values": [
              "api.clients.growthcast.app"
            ]
          },
          {
            "Field": "path-pattern",
            "Values": [
              "/api/*"
            ]
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "Target"
            }
          }
        ]
      }
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": "growthcast-portal-production-api"
      }
    },
    "Task": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "growthcast-portal-production-api",
        "Cpu": "512",
        "Memory": "1024",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "TaskRoleArn": "arn:aws:iam::059393269249:role/growthcast-portal-production-runtime",
        "ExecutionRoleArn": "arn:aws:iam::059393269249:role/growthcast-portal-production-execution",
        "Volumes": [
          {
            "Name": "delivered"
          },
          {
            "Name": "origin"
          },
          {
            "Name": "connections"
          },
          {
            "Name": "storage"
          },
          {
            "Name": "config"
          },
          {
            "Name": "tmp"
          },
          {
            "Name": "signing"
          }
        ],
        "ContainerDefinitions": [
          {
            "Name": "api",
            "Image": "059393269249.dkr.ecr.us-east-1.amazonaws.com/growthcast-portal-production@sha256:776e2caca67eed6896cbe481657aefbb54b6096c2b5c9d74797609a0f7627a97",
            "Essential": true,
            "User": "1000:1000",
            "ReadonlyRootFilesystem": true,
            "StopTimeout": 30,
            "LinuxParameters": {
              "Capabilities": {
                "Drop": [
                  "ALL"
                ]
              },
              "InitProcessEnabled": true
            },
            "EntryPoint": [
              "/usr/local/bin/bun"
            ],
            "Command": [
              "--input-type=module",
              "-e",
              "import {writeFileSync} from 'node:fs';\nimport {spawn} from 'node:child_process';\nconst env={NODE_ENV:'production',PATH:'/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin',PORT:'3001',WEB_URL:'https://clients.growthcast.app',API_URL:'https://clients.growthcast.app',SECURE_COOKIES:'true',ALLOW_SIGNUPS:'false',BILLING_ENABLED:'false',STORAGE_PROVIDER:'supabase',PORTAL_STORAGE_PROJECT_REF:'mdjldxussxdtcjxsoesr',PORTAL_STORAGE_BUCKET:'gc-atrium-private',SENTRY_ENABLED:'false',LOG_LEVEL:'silent',PORTAL_MAIL_MODE:'workspace-smtp',PORTAL_MAIL_ORGANIZATION_ID:'review-a40f59d0c00e6dc6-org',PORTAL_MAIL_CAPTURE_HOST:'127.0.0.1'};\nwriteFileSync('/run/config/application-env.json',JSON.stringify(env),{flag:'wx',mode:0o400});\nconst child=spawn('/usr/local/bin/bun',['/boundary/deployment/runtime/start.mjs','/usr/local/bin/bun','/upstream/apps/api/dist/main.js'],{env:{...process.env,GC_SERVICE:'atrium',GC_SECRET_MODE:'secretsmanager',SUPABASE_PROJECT_REF:'mdjldxussxdtcjxsoesr'},stdio:'ignore'});\nfor(const signal of ['SIGTERM','SIGINT'])process.on(signal,()=>child.kill(signal));\nchild.on('error',()=>{console.error('Staging API launch failed');process.exitCode=1;});\nchild.on('exit',(code)=>{console.log(JSON.stringify({event:'application-exit',code}));process.exitCode=code??1;});\n"
            ],
            "PortMappings": [
              {
                "ContainerPort": 3001,
                "Protocol": "tcp"
              }
            ],
            "MountPoints": [
              {
                "SourceVolume": "delivered",
                "ContainerPath": "/run/delivered",
                "ReadOnly": false
              },
              {
                "SourceVolume": "origin",
                "ContainerPath": "/run/origin",
                "ReadOnly": false
              },
              {
                "SourceVolume": "connections",
                "ContainerPath": "/run/connections",
                "ReadOnly": false
              },
              {
                "SourceVolume": "storage",
                "ContainerPath": "/run/storage",
                "ReadOnly": false
              },
              {
                "SourceVolume": "config",
                "ContainerPath": "/run/config",
                "ReadOnly": false
              },
              {
                "SourceVolume": "tmp",
                "ContainerPath": "/tmp",
                "ReadOnly": false
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD",
                "/usr/local/bin/bun",
                "-e",
                "const r=await fetch('http://127.0.0.1:3001/api/health');process.exit(r.status===200?0:1)"
              ],
              "Interval": 15,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 60
            },
            "DependsOn": [
              {
                "ContainerName": "mail",
                "Condition": "HEALTHY"
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": "/growthcast/portal/production",
                "awslogs-region": "us-east-1",
                "awslogs-stream-prefix": "production-api"
              }
            }
          },
          {
            "Name": "mail",
            "Image": "059393269249.dkr.ecr.us-east-1.amazonaws.com/growthcast-portal-staging-backup@sha256:05948896aff615bd92a121ca0820fd3959fc2c07707abd2770fe6b3f052cb4d5",
            "Essential": true,
            "MemoryReservation": 128,
            "HealthCheck": {
              "Command": [
                "CMD-SHELL",
                "wget -q -O - http://127.0.0.1:1080/healthz || exit 1"
              ],
              "Interval": 10,
              "Timeout": 3,
              "Retries": 5,
              "StartPeriod": 10
            }
          },
          {
            "Name": "guest",
            "Image": "059393269249.dkr.ecr.us-east-1.amazonaws.com/growthcast-portal-production@sha256:f956c0fa956b1113467b30f416fc013b5b3ba1f2347a0174e2380905bb84c58e",
            "Essential": true,
            "User": "1000",
            "ReadonlyRootFilesystem": true,
            "Environment": [
              {
                "Name": "GC_GUEST_SHARED_RUNTIME",
                "Value": "1"
              },
              {
                "Name": "GC_SIGNING_SERVICE",
                "Value": "delivery"
              }
            ],
            "DependsOn": [
              {
                "ContainerName": "api",
                "Condition": "HEALTHY"
              }
            ],
            "PortMappings": [
              {
                "ContainerPort": 3002,
                "Protocol": "tcp"
              }
            ],
            "MountPoints": [
              {
                "SourceVolume": "connections",
                "ContainerPath": "/run/connections",
                "ReadOnly": true
              },
              {
                "SourceVolume": "origin",
                "ContainerPath": "/run/origin",
                "ReadOnly": true
              },
              {
                "SourceVolume": "storage",
                "ContainerPath": "/run/storage",
                "ReadOnly": true
              },
              {
                "SourceVolume": "signing",
                "ContainerPath": "/run/signing",
                "ReadOnly": false
              },
              {
                "SourceVolume": "delivered",
                "ContainerPath": "/run/delivered",
                "ReadOnly": true
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": "/growthcast/portal/production",
                "awslogs-region": "us-east-1",
                "awslogs-stream-prefix": "production-documents"
              }
            },
            "HealthCheck": {
              "Command": [
                "CMD",
                "node",
                "-e",
                "fetch('http://127.0.0.1:3002/health').then(r=>process.exit(r.status===200?0:1)).catch(()=>process.exit(1))"
              ],
              "Interval": 15,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 60
            },
            "LinuxParameters": {
              "Capabilities": {
                "Drop": [
                  "ALL"
                ]
              }
            },
            "EntryPoint": [
              "node"
            ],
            "Command": [
              "/app/guest-documents/runtime/signing-start.mjs"
            ],
            "StopTimeout": 120
          }
        ]
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "ServiceName": "growthcast-portal-production-api",
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "Task"
        },
        "DesiredCount": 1,
        "LaunchType": "FARGATE",
        "PlatformVersion": "1.4.0",
        "HealthCheckGracePeriodSeconds": 120,
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          },
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": [
              {
                "Ref": "Subnet0"
              },
              {
                "Ref": "Subnet1"
              }
            ],
            "SecurityGroups": [
              {
                "Ref": "ApiSecurityGroup"
              }
            ],
            "AssignPublicIp": "ENABLED"
          }
        },
        "LoadBalancers": [
          {
            "ContainerName": "api",
            "ContainerPort": 3001,
            "TargetGroupArn": {
              "Ref": "Target"
            }
          },
          {
            "ContainerName": "guest",
            "ContainerPort": 3002,
            "TargetGroupArn": {
              "Ref": "GuestTarget"
            }
          }
        ]
      },
      "DependsOn": [
        "ApiRoute",
        "InternetRoute",
        "ApiIngress",
        "RouteAssociation0",
        "RouteAssociation1",
        "GuestRoute"
      ]
    },
    "GuestTarget": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Port": 3002,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "HealthCheckPath": "/health",
        "Matcher": {
          "HttpCode": "200"
        },
        "HealthCheckIntervalSeconds": 15,
        "HealthyThresholdCount": 2,
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ]
      }
    },
    "GuestIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "ApiSecurityGroup"
        },
        "IpProtocol": "tcp",
        "FromPort": 3002,
        "ToPort": 3002,
        "SourceSecurityGroupId": {
          "Ref": "LoadBalancerSecurityGroup"
        }
      }
    },
    "GuestRoute": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "DependsOn": "ApiRoute",
      "Properties": {
        "ListenerArn": {
          "Ref": "Listener"
        },
        "Priority": 2,
        "Conditions": [
          {
            "Field": "host-header",
            "Values": [
              "api.clients.growthcast.app"
            ]
          },
          {
            "Field": "path-pattern",
            "Values": [
              "/api/guest/staff/*"
            ]
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "GuestTarget"
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "LoadBalancerDns": {
      "Value": {
        "Fn::GetAtt": [
          "LoadBalancer",
          "DNSName"
        ]
      }
    },
    "LoadBalancerArn": {
      "Value": {
        "Ref": "LoadBalancer"
      }
    },
    "ListenerArn": {
      "Value": {
        "Ref": "Listener"
      }
    },
    "TargetGroupArn": {
      "Value": {
        "Ref": "Target"
      }
    },
    "ClusterArn": {
      "Value": {
        "Fn::GetAtt": [
          "Cluster",
          "Arn"
        ]
      }
    },
    "ServiceArn": {
      "Value": {
        "Ref": "Service"
      }
    },
    "TaskDefinitionArn": {
      "Value": {
        "Ref": "Task"
      }
    },
    "ApiSecurityGroup": {
      "Value": {
        "Ref": "ApiSecurityGroup"
      }
    },
    "GuestTargetGroupArn": {
      "Value": {
        "Ref": "GuestTarget"
      }
    }
  }
}
