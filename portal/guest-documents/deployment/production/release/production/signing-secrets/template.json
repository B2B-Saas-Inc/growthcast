{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Separate production signing credential delivery; no service or database login enabled.",
  "Resources": {
    "GatewayRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "growthcast-portal-production-signing-gateway",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": "059393269249"
                },
                "ArnLike": {
                  "aws:SourceArn": "arn:aws:ecs:us-east-1:059393269249:*"
                }
              }
            }
          ]
        }
      }
    },
    "LifecycleRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "growthcast-portal-production-signing-lifecycle",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": "059393269249"
                },
                "ArnLike": {
                  "aws:SourceArn": "arn:aws:ecs:us-east-1:059393269249:*"
                }
              }
            }
          ]
        }
      }
    },
    "Key": {
      "Type": "AWS::KMS::Key",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": "Staging portal delivery and role-separated signing credentials",
        "EnableKeyRotation": true,
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "Administration",
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::059393269249:root"
              },
              "Action": "kms:*",
              "Resource": "*"
            },
            {
              "Sid": "ExcludeUnrelatedReaders",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "kms:Decrypt",
              "Resource": "*",
              "Condition": {
                "ArnNotEquals": {
                  "aws:PrincipalArn": [
                    "arn:aws:iam::059393269249:root",
                    "arn:aws:iam::059393269249:role/growthcast-portal-production-runtime",
                    "arn:aws:iam::059393269249:role/growthcast-portal-production-signing-gateway",
                    "arn:aws:iam::059393269249:role/growthcast-portal-production-signing-lifecycle"
                  ]
                }
              }
            },
            {
              "Sid": "RuntimeOnlyViaSecretsManager",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "kms:Decrypt",
              "Resource": "*",
              "Condition": {
                "ArnEquals": {
                  "aws:PrincipalArn": [
                    "arn:aws:iam::059393269249:role/growthcast-portal-production-runtime",
                    "arn:aws:iam::059393269249:role/growthcast-portal-production-signing-gateway",
                    "arn:aws:iam::059393269249:role/growthcast-portal-production-signing-lifecycle"
                  ]
                },
                "StringNotEquals": {
                  "kms:ViaService": "secretsmanager.us-east-1.amazonaws.com"
                }
              }
            }
          ]
        }
      }
    },
    "DeliverySecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "growthcast/portal/production/signing/delivery",
        "KmsKeyId": {
          "Ref": "Key"
        },
        "Description": "Private delivery configuration; production only"
      }
    },
    "DeliveryRead": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "growthcast-production-signing-delivery",
        "Roles": [
          "growthcast-portal-production-runtime"
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "secretsmanager:GetSecretValue"
              ],
              "Resource": {
                "Ref": "DeliverySecret"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "kms:Decrypt"
              ],
              "Resource": {
                "Fn::GetAtt": [
                  "Key",
                  "Arn"
                ]
              },
              "Condition": {
                "StringEquals": {
                  "kms:ViaService": "secretsmanager.us-east-1.amazonaws.com",
                  "kms:EncryptionContext:SecretARN": {
                    "Ref": "DeliverySecret"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "GatewaySecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "growthcast/portal/production/signing/gateway",
        "KmsKeyId": {
          "Ref": "Key"
        },
        "Description": "Private gateway configuration; production only"
      }
    },
    "GatewayRead": {
      "Type": "AWS::IAM::Policy",
      "DependsOn": "GatewayRole",
      "Properties": {
        "PolicyName": "growthcast-production-signing-gateway",
        "Roles": [
          "growthcast-portal-production-signing-gateway"
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "secretsmanager:GetSecretValue"
              ],
              "Resource": {
                "Ref": "GatewaySecret"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "kms:Decrypt"
              ],
              "Resource": {
                "Fn::GetAtt": [
                  "Key",
                  "Arn"
                ]
              },
              "Condition": {
                "StringEquals": {
                  "kms:ViaService": "secretsmanager.us-east-1.amazonaws.com",
                  "kms:EncryptionContext:SecretARN": {
                    "Ref": "GatewaySecret"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "LifecycleSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "growthcast/portal/production/signing/lifecycle",
        "KmsKeyId": {
          "Ref": "Key"
        },
        "Description": "Private lifecycle configuration; production only"
      }
    },
    "LifecycleRead": {
      "Type": "AWS::IAM::Policy",
      "DependsOn": "LifecycleRole",
      "Properties": {
        "PolicyName": "growthcast-production-signing-lifecycle",
        "Roles": [
          "growthcast-portal-production-signing-lifecycle"
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "secretsmanager:GetSecretValue"
              ],
              "Resource": {
                "Ref": "LifecycleSecret"
              }
            },
            {
              "Effect": "Allow",
              "Action": [
                "kms:Decrypt"
              ],
              "Resource": {
                "Fn::GetAtt": [
                  "Key",
                  "Arn"
                ]
              },
              "Condition": {
                "StringEquals": {
                  "kms:ViaService": "secretsmanager.us-east-1.amazonaws.com",
                  "kms:EncryptionContext:SecretARN": {
                    "Ref": "LifecycleSecret"
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "DeliverySecretArn": {
      "Value": {
        "Ref": "DeliverySecret"
      }
    },
    "GatewaySecretArn": {
      "Value": {
        "Ref": "GatewaySecret"
      }
    },
    "LifecycleSecretArn": {
      "Value": {
        "Ref": "LifecycleSecret"
      }
    },
    "KeyArn": {
      "Value": {
        "Fn::GetAtt": [
          "Key",
          "Arn"
        ]
      }
    }
  }
}
