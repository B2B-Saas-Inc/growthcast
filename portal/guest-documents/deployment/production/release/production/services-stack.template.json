{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Staging-only restricted recipient gateway and signature completion worker.",
  "Parameters": {
    "DesiredCount": {
      "Type": "Number",
      "Default": 1,
      "AllowedValues": [
        0,
        1
      ]
    }
  },
  "Resources": {
    "ProviderEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": "sg-05d156000893ea372",
        "IpProtocol": "tcp",
        "FromPort": 3000,
        "ToPort": 3000,
        "DestinationSecurityGroupId": "sg-043bb04665d4a72bc"
      }
    },
    "GatewayEgress": {
      "Type": "AWS::EC2::SecurityGroupEgress",
      "Properties": {
        "GroupId": "sg-084f684b1507a9c62",
        "IpProtocol": "tcp",
        "FromPort": 3003,
        "ToPort": 3003,
        "DestinationSecurityGroupId": "sg-05d156000893ea372"
      }
    },
    "GatewayIngress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": "sg-05d156000893ea372",
        "IpProtocol": "tcp",
        "FromPort": 3003,
        "ToPort": 3003,
        "SourceSecurityGroupId": "sg-084f684b1507a9c62"
      }
    },
    "Target": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": "vpc-00de83d5f8563f216",
        "Port": 3003,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "HealthCheckPath": "/health",
        "Matcher": {
          "HttpCode": "200"
        },
        "HealthCheckIntervalSeconds": 15,
        "HealthyThresholdCount": 2,
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ]
      }
    },
    "SigningApi": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": "arn:aws:elasticloadbalancing:us-east-1:059393269249:listener/app/growth-LoadB-3lKqw1F6QD5k/1c140dc074d55c35/b9ab20d6c0f89c3c",
        "Priority": 3,
        "Conditions": [
          {
            "Field": "host-header",
            "Values": [
              "api.clients.growthcast.app"
            ]
          },
          {
            "Field": "path-pattern",
            "Values": [
              "/api/trpc/*",
              "/api/files/token/*",
              "/api/auth/session-json",
              "/api/branding/logo/team/3"
            ]
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "Target"
            }
          }
        ]
      }
    },
    "SigningPage": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": "arn:aws:elasticloadbalancing:us-east-1:059393269249:listener/app/growth-LoadB-3lKqw1F6QD5k/1c140dc074d55c35/b9ab20d6c0f89c3c",
        "Priority": 20,
        "Conditions": [
          {
            "Field": "host-header",
            "Values": [
              "api.clients.growthcast.app"
            ]
          },
          {
            "Field": "path-pattern",
            "Values": [
              "/*"
            ]
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "Target"
            }
          }
        ]
      }
    },
    "GatewayTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "growthcast-portal-production-signing-gateway",
        "Cpu": "256",
        "Memory": "512",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "TaskRoleArn": "arn:aws:iam::059393269249:role/growthcast-portal-production-signing-gateway",
        "ExecutionRoleArn": "arn:aws:iam::059393269249:role/growthcast-portal-production-execution",
        "Volumes": [
          {
            "Name": "private"
          },
          {
            "Name": "tmp"
          }
        ],
        "ContainerDefinitions": [
          {
            "Name": "gateway",
            "Image": "059393269249.dkr.ecr.us-east-1.amazonaws.com/growthcast-portal-production@sha256:f956c0fa956b1113467b30f416fc013b5b3ba1f2347a0174e2380905bb84c58e",
            "Essential": true,
            "User": "1000:1000",
            "ReadonlyRootFilesystem": true,
            "StopTimeout": 120,
            "LinuxParameters": {
              "Capabilities": {
                "Drop": [
                  "ALL"
                ]
              },
              "InitProcessEnabled": true
            },
            "EntryPoint": [
              "node"
            ],
            "Command": [
              "/app/guest-documents/runtime/signing-start.mjs"
            ],
            "Environment": [
              {
                "Name": "GC_SIGNING_SERVICE",
                "Value": "gateway"
              }
            ],
            "MountPoints": [
              {
                "SourceVolume": "private",
                "ContainerPath": "/run/gateway",
                "ReadOnly": false
              },
              {
                "SourceVolume": "tmp",
                "ContainerPath": "/tmp",
                "ReadOnly": false
              }
            ],
            "PortMappings": [
              {
                "ContainerPort": 3003,
                "Protocol": "tcp"
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD",
                "node",
                "-e",
                "fetch('http://127.0.0.1:3003/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
              ],
              "Interval": 15,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 90
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": "/growthcast/portal/production/signing-provider",
                "awslogs-region": "us-east-1",
                "awslogs-stream-prefix": "gateway"
              }
            }
          }
        ]
      }
    },
    "GatewayService": {
      "Type": "AWS::ECS::Service",
      "DependsOn": [
        "SigningApi",
        "SigningPage",
        "ProviderEgress",
        "GatewayIngress",
        "GatewayEgress"
      ],
      "Properties": {
        "ServiceName": "growthcast-portal-production-signing-gateway",
        "Cluster": "growthcast-portal-production-api",
        "TaskDefinition": {
          "Ref": "GatewayTask"
        },
        "DesiredCount": {
          "Ref": "DesiredCount"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "1.4.0",
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          },
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": [
              "subnet-03aae91eef1901d5d",
              "subnet-0c0b01954bff6ce81"
            ],
            "SecurityGroups": [
              "sg-05d156000893ea372"
            ],
            "AssignPublicIp": "ENABLED"
          }
        },
        "HealthCheckGracePeriodSeconds": 120,
        "LoadBalancers": [
          {
            "ContainerName": "gateway",
            "ContainerPort": 3003,
            "TargetGroupArn": {
              "Ref": "Target"
            }
          }
        ]
      }
    },
    "LifecycleTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "growthcast-portal-production-signing-lifecycle",
        "Cpu": "256",
        "Memory": "512",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "TaskRoleArn": "arn:aws:iam::059393269249:role/growthcast-portal-production-signing-lifecycle",
        "ExecutionRoleArn": "arn:aws:iam::059393269249:role/growthcast-portal-production-execution",
        "Volumes": [
          {
            "Name": "private"
          },
          {
            "Name": "tmp"
          }
        ],
        "ContainerDefinitions": [
          {
            "Name": "lifecycle",
            "Image": "059393269249.dkr.ecr.us-east-1.amazonaws.com/growthcast-portal-production@sha256:f956c0fa956b1113467b30f416fc013b5b3ba1f2347a0174e2380905bb84c58e",
            "Essential": true,
            "User": "1000:1000",
            "ReadonlyRootFilesystem": true,
            "StopTimeout": 120,
            "LinuxParameters": {
              "Capabilities": {
                "Drop": [
                  "ALL"
                ]
              },
              "InitProcessEnabled": true
            },
            "EntryPoint": [
              "node"
            ],
            "Command": [
              "/app/guest-documents/runtime/signing-start.mjs"
            ],
            "Environment": [
              {
                "Name": "GC_SIGNING_SERVICE",
                "Value": "lifecycle"
              }
            ],
            "MountPoints": [
              {
                "SourceVolume": "private",
                "ContainerPath": "/run/lifecycle",
                "ReadOnly": false
              },
              {
                "SourceVolume": "tmp",
                "ContainerPath": "/tmp",
                "ReadOnly": false
              }
            ],
            "PortMappings": [
              {
                "ContainerPort": 3004,
                "Protocol": "tcp"
              }
            ],
            "HealthCheck": {
              "Command": [
                "CMD",
                "node",
                "-e",
                "fetch('http://127.0.0.1:3004/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
              ],
              "Interval": 15,
              "Timeout": 5,
              "Retries": 3,
              "StartPeriod": 90
            },
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": "/growthcast/portal/production/signing-provider",
                "awslogs-region": "us-east-1",
                "awslogs-stream-prefix": "lifecycle"
              }
            }
          }
        ]
      }
    },
    "LifecycleService": {
      "Type": "AWS::ECS::Service",
      "DependsOn": [
        "SigningApi",
        "SigningPage",
        "ProviderEgress",
        "GatewayIngress",
        "GatewayEgress"
      ],
      "Properties": {
        "ServiceName": "growthcast-portal-production-signing-lifecycle",
        "Cluster": "growthcast-portal-production-api",
        "TaskDefinition": {
          "Ref": "LifecycleTask"
        },
        "DesiredCount": {
          "Ref": "DesiredCount"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "1.4.0",
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          },
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": [
              "subnet-03aae91eef1901d5d",
              "subnet-0c0b01954bff6ce81"
            ],
            "SecurityGroups": [
              "sg-05d156000893ea372"
            ],
            "AssignPublicIp": "ENABLED"
          }
        }
      }
    }
  },
  "Outputs": {
    "GatewayTargetArn": {
      "Value": {
        "Ref": "Target"
      }
    },
    "GatewayServiceArn": {
      "Value": {
        "Ref": "GatewayService"
      }
    },
    "LifecycleServiceArn": {
      "Value": {
        "Ref": "LifecycleService"
      }
    }
  }
}
