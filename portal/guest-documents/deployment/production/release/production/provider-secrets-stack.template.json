{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Resources": {
    "Role": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "growthcast-portal-production-documenso-runtime",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": "059393269249"
                },
                "ArnLike": {
                  "aws:SourceArn": "arn:aws:ecs:us-east-1:059393269249:*"
                }
              }
            }
          ]
        }
      }
    },
    "Key": {
      "Type": "AWS::KMS::Key",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "EnableKeyRotation": true,
        "KeyPolicy": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::059393269249:root"
              },
              "Action": "kms:*",
              "Resource": "*"
            },
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "kms:Decrypt",
              "Resource": "*",
              "Condition": {
                "ArnNotEquals": {
                  "aws:PrincipalArn": [
                    "arn:aws:iam::059393269249:root",
                    "arn:aws:iam::059393269249:role/growthcast-portal-production-documenso-runtime"
                  ]
                }
              }
            },
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "kms:Decrypt",
              "Resource": "*",
              "Condition": {
                "ArnEquals": {
                  "aws:PrincipalArn": "arn:aws:iam::059393269249:role/growthcast-portal-production-documenso-runtime"
                },
                "StringNotEquals": {
                  "kms:ViaService": "secretsmanager.us-east-1.amazonaws.com"
                }
              }
            }
          ]
        }
      }
    },
    "Runtime": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "growthcast/portal/production/documenso/runtime",
        "KmsKeyId": {
          "Ref": "Key"
        }
      }
    },
    "Connection": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "growthcast/portal/production/documenso/connection",
        "KmsKeyId": {
          "Ref": "Key"
        }
      }
    },
    "Certificate": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "growthcast/portal/production/documenso/certificate",
        "KmsKeyId": {
          "Ref": "Key"
        }
      }
    },
    "Api": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": "growthcast/portal/production/documenso/api",
        "KmsKeyId": {
          "Ref": "Key"
        }
      }
    },
    "Read": {
      "Type": "AWS::IAM::Policy",
      "Properties": {
        "PolicyName": "production-provider-private-config",
        "Roles": [
          {
            "Ref": "Role"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "secretsmanager:GetSecretValue",
              "Resource": [
                {
                  "Ref": "Runtime"
                },
                {
                  "Ref": "Connection"
                },
                {
                  "Ref": "Certificate"
                }
              ]
            },
            {
              "Effect": "Allow",
              "Action": "kms:Decrypt",
              "Resource": {
                "Fn::GetAtt": [
                  "Key",
                  "Arn"
                ]
              },
              "Condition": {
                "StringEquals": {
                  "kms:ViaService": "secretsmanager.us-east-1.amazonaws.com",
                  "kms:EncryptionContext:SecretARN": [
                    {
                      "Ref": "Runtime"
                    },
                    {
                      "Ref": "Connection"
                    },
                    {
                      "Ref": "Certificate"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "KeyArn": {
      "Value": {
        "Fn::GetAtt": [
          "Key",
          "Arn"
        ]
      }
    },
    "RuntimeArn": {
      "Value": {
        "Ref": "Runtime"
      }
    },
    "ConnectionArn": {
      "Value": {
        "Ref": "Connection"
      }
    },
    "CertificateArn": {
      "Value": {
        "Ref": "Certificate"
      }
    },
    "ApiArn": {
      "Value": {
        "Ref": "Api"
      }
    }
  }
}
