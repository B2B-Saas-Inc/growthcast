# Server/operator-only. Never expose these values through a VITE_ prefix.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional OpenRouter-compatible endpoint and bounded retry count (1-10).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_ATTEMPTS=3
# Optional attribution headers; use the property-specific values shown here.
OPENROUTER_SITE_URL=https://growthcast.app
OPENROUTER_APP_NAME=GrowthCast content generation

# Optional overrides for the browser-safe PostHog project key embedded in the app.
VITE_POSTHOG_KEY=
POSTHOG_PROJECT_TOKEN=
POSTHOG_CAPTURE_HOST=https://us.i.posthog.com

# Positioning Wizard (server-only). POSTGRES_URL comes from the Vercel Supabase integration.
POSTGRES_URL=
# At least 32 random characters, e.g. `openssl rand -hex 32`. Configure Preview and Production separately.
WIZARD_SESSION_SECRET=
# Optional: model for the wizard; falls back to OPENROUTER_MODEL. Use a model with long outputs and web search support.
WIZARD_OPENROUTER_MODEL=
