# Server/operator-only. Never expose these values through a VITE_ prefix.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional OpenRouter-compatible endpoint and bounded retry count (1-10).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_ATTEMPTS=3
# Optional attribution headers; use the property-specific values shown here.
OPENROUTER_SITE_URL=https://growthcast.app
OPENROUTER_APP_NAME=GrowthCast content generation

# Browser-safe analytics key; analytics remains disabled when omitted.
VITE_POSTHOG_KEY=
