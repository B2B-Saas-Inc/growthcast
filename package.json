    "astro": "7.2.9",
    "html-to-image": "1.11.13",
    "html2canvas": "1.4.1",
    "jspdf": "4.2.1",
    "jszip": "3.10.1",
    "lucide-react": "1.28.0",
    "posthog-js": "1.424.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  },
