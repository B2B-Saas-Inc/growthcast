{
  "name": "growth-model",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4173",
    "build": "astro check && astro build && npm run content:rendered && npm run indexnow",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "astro preview --host 127.0.0.1",
    "content:drift": "node scripts/check-content-engine-drift.mjs",
    "content:briefs:migrate": "node scripts/migrate-content-briefs.mjs",
    "content:briefs:check": "node scripts/migrate-content-briefs.mjs --check",
    "content:inventory": "node scripts/content-astro-adapter.mjs inventory",
    "content:validate": "node scripts/content-astro-adapter.mjs validate",
    "content:draft": "node scripts/content-astro-adapter.mjs draft",
    "content:preflight": "node scripts/content-astro-adapter.mjs preflight",
    "content:schedule:dry-run": "PUBLISH_DRY_RUN=true node scripts/publish-due-posts.mjs",
    "content:rendered": "node scripts/check-rendered-blog.mjs",
    "content:generate": "node scripts/content-generation/cli.mjs"
  },
  "dependencies": {
    "@astrojs/react": "6.0.4",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
